# Neon PostgreSQL (obter em neon.tech)
DATABASE_URL=postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=gerado_com_npx_better-auth_secret

# Cloudflare Workers AI (opcional — habilita diagnostico de lead, geracao de
# mensagem e selecao de tags OSM por IA nas campanhas de prospeccao).
# Sem essas variaveis, o restante da aplicacao funciona normalmente.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-70b-instruct
